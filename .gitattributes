# ============================================================
# 碳足迹项目 · .gitattributes
# 目的：统一换行符，消除 "LF will be replaced by CRLF" 警告
# 原理：仓库内一律存 LF，检出到 Windows 时自动转 CRLF
#      二进制文件不参与转换，避免损坏
# ============================================================

# 默认行为：自动识别文本，仓库内统一 LF
* text=auto eol=lf

# ---------- 源码：强制 LF（跨平台一致，避免整文件 diff） ----------
*.ets   text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.json5 text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# ---------- Windows 脚本：必须 CRLF，否则 cmd 可能执行异常 ----------
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# ---------- Shell 脚本：必须 LF，否则 Linux/macOS 下无法执行 ----------
*.sh    text eol=lf
gradlew text eol=lf

# ---------- 二进制：禁止任何转换 ----------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.mov   binary
*.avi  binary
*.mp3   binary
*.wav   binary
*.zip   binary
*.jar   binary
*.bundle binary
*.hap   binary
*.hsp   binary
*.app   binary
*.apk   binary
*.aab   binary
*.so    binary
*.dll   binary
*.exe   binary
*.p12   binary
*.cer   binary
*.p7b   binary
*.jks   binary
*.keystore binary
*.ttf   binary
*.otf   binary
*.pptx  binary
*.docx  binary
*.xlsx  binary
*.pdf   binary

# ---------- 语言统计：让 GitHub 不把前端依赖算成主语言 ----------
*.ets linguist-language=TypeScript